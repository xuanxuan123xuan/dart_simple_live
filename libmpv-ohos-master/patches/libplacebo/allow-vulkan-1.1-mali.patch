+    const VkPhysicalDeviceHostQueryResetFeatures *hq = vk_find_struct(&vk->features,
+        VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_HOST_QUERY_RESET_FEATURES);
+    if (!ts || !ts->timelineSemaphore || !hq || !hq->hostQueryReset) {
+        PL_ERR(vk, "Vulkan 1.1 device missing timelineSemaphore/hostQueryReset");
