+        *hq = (VkPhysicalDeviceHostQueryResetFeatures) {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_HOST_QUERY_RESET_FEATURES,
+            .pNext = features.pNext,
+            .hostQueryReset = true,
+        };
+        VkPhysicalDeviceTimelineSemaphoreFeatures *ts = pl_alloc_ptr(tmp, ts);
+        *ts = (VkPhysicalDeviceTimelineSemaphoreFeatures) {
+            .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES,
+            .pNext = hq,
+            .timelineSemaphore = true,
+        };
+        features.pNext = ts;
+    }
 
