@@ -1229,6 +1242,25 @@
     if (params->surface)
         PL_ARRAY_APPEND(vk->alloc, vk->exts, VK_KHR_SWAPCHAIN_EXTENSION_NAME);
 
+    if (vk->api_ver < VK_API_VERSION_1_2) {
+        bool have_ts = false, have_hq = false;
+        for (int n = 0; n < num_exts_avail; n++) {
+            if (strcmp(exts_avail[n].extensionName,
+                       VK_KHR_TIMELINE_SEMAPHORE_EXTENSION_NAME) == 0)
+                have_ts = true;
+            if (strcmp(exts_avail[n].extensionName,
+                       VK_EXT_HOST_QUERY_RESET_EXTENSION_NAME) == 0)
+                have_hq = true;
+        }
+        if (!have_ts || !have_hq) {
+            PL_FATAL(vk, "Vulkan 1.1 device lacks timeline/hostQueryReset extensions");
+            goto error;
+        }
+        PL_ARRAY_APPEND(vk->alloc, vk->exts, VK_KHR_TIMELINE_SEMAPHORE_EXTENSION_NAME);
+        PL_ARRAY_APPEND(vk->alloc, vk->exts, VK_EXT_HOST_QUERY_RESET_EXTENSION_NAME);
+        PL_WARN(vk, "Using Vulkan 1.1 with KHR timeline / EXT hostQueryReset");
+    }
+
     // Keep track of all optional function pointers associated with extensions
     PL_ARRAY(const struct vk_fun *) ext_funs = {0};
 
@@ -1275,6 +1307,22 @@
     vk_features_normalize(tmp, &pl_vulkan_required_features, vk->api_ver, &features);
     vk_features_normalize(tmp, &pl_vulkan_recommended_features, vk->api_ver, &features);
     vk_features_normalize(tmp, params->features, vk->api_ver, &features);
