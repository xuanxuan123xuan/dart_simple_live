+/* AnnexB NAL type classes we care about while feeding OHCodec. */
+#define OH_NAL_CLASS_SPS (1 << 0)   /* H.264 SPS, HEVC VPS/SPS */
+#define OH_NAL_CLASS_PPS (1 << 1)
+#define OH_NAL_CLASS_IDR (1 << 2)
+
+/*
+ * Bootstrap hold is bounded so a stream without parameter sets still surfaces
+ * decode errors and lets mpv fall back to software decoding.
+ *
+ * Budget is stream time (packet count is only the fallback when pts is
+ * unavailable). 6s: on-device captures 2026-08-11/12 (Huya FLV, SDR + 60fps
+ * HDR up to 2K) measured holds of ~0.7-2.8s of stream time before the IDR
+ * arrived; live platforms keep GOPs short for latency, so 6s keeps >2x margin
+ * over the observed worst case while halving the previous 12s worst-case
+ * black window on streams that never deliver parameter sets.
+ */
+#define OH_BOOTSTRAP_MAX_USEC  (6LL * AV_TIME_BASE)
+#define OH_BOOTSTRAP_MAX_DROPS 300
+
+/*
+ * Classify the NAL units inside an AnnexB buffer.
+ *
+ * SPS and PPS are reported separately on purpose: a packet (or an extradata
+ * blob) may carry only a PPS, which is NOT enough to configure the decoder.
+ * Treating a lone PPS as "parameter sets present" is exactly what makes
+ * OHCodec fail with "missing parameter sets".
+ */
+static unsigned oh_decode_scan_nals(const uint8_t *data, int size,
+                                    enum AVCodecID id)
+{
+    const uint8_t *p = data;
+    const uint8_t *end;
+    unsigned found = 0;
+
+    if (!data || size < 4)
+        return 0;
+    end = data + size;
+    while (p + 3 < end) {
+        int nal_type;
+        if (p[0] == 0 && p[1] == 0 && p[2] == 1) {
+            p += 3;
+        } else if (p + 4 < end &&
+                   p[0] == 0 && p[1] == 0 && p[2] == 0 && p[3] == 1) {
+            p += 4;
+        } else {
+            p++;
+            continue;
+        }
+        if (p >= end)
+            break;
+        if (id == AV_CODEC_ID_HEVC) {
+            nal_type = (*p >> 1) & 0x3f;
+            if (nal_type == 32 || nal_type == 33)
+                found |= OH_NAL_CLASS_SPS;
+            else if (nal_type == 34)
+                found |= OH_NAL_CLASS_PPS;
+            /* IDR_W_RADL/IDR_N_LP/CRA plus BLA variants all restart the stream */
+            else if (nal_type >= 16 && nal_type <= 21)
+                found |= OH_NAL_CLASS_IDR;
+        } else {
+            nal_type = *p & 0x1f;
+            if (nal_type == 7)
+                found |= OH_NAL_CLASS_SPS;
+            else if (nal_type == 8)
+                found |= OH_NAL_CLASS_PPS;
+            else if (nal_type == 5)
+                found |= OH_NAL_CLASS_IDR;
+        }
+    }
+    return found;
+}
