+static enum AVPixelFormat oh_sw_format_from_native_format(OH_NativeBuffer_Format format)
+{
+    switch (format) {
+    case NATIVEBUFFER_PIXEL_FMT_YCBCR_P010:
+    case NATIVEBUFFER_PIXEL_FMT_YCRCB_P010:
+        return AV_PIX_FMT_P010;
+    case NATIVEBUFFER_PIXEL_FMT_YCBCR_420_SP:
+        return AV_PIX_FMT_NV12;
+    case NATIVEBUFFER_PIXEL_FMT_YCRCB_420_SP:
+        return AV_PIX_FMT_NV21;
+    default:
+        return AV_PIX_FMT_NONE;
+    }
+}
+
+/* Vendor OnOutputFormatChanged dumps these; not in public OH_MD_KEY_* macros. */
+#define OH_KEY_VIDEO_GRAPHIC_PIXEL_FORMAT "video_graphic_pixel_format"
+#define OH_KEY_PIXEL_FORMAT_STRING        "pixel_format_string"
+
+static int oh_sw_format_is_concrete(enum AVPixelFormat sw)
+{
+    return sw != AV_PIX_FMT_NONE && sw != AV_PIX_FMT_OHCODEC;
+}
+
+static enum AVPixelFormat oh_decode_sw_format_from_avformat(OH_AVFormat *format)
+{
+    int32_t graphic = 0;
+    const char *pfs = NULL;
+    enum AVPixelFormat sw;
+
+    if (OH_AVFormat_GetIntValue(format, OH_KEY_VIDEO_GRAPHIC_PIXEL_FORMAT, &graphic)) {
+        sw = oh_sw_format_from_native_format((OH_NativeBuffer_Format)graphic);
+        if (oh_sw_format_is_concrete(sw))
+            return sw;
+    }
+    if (OH_AVFormat_GetStringValue(format, OH_KEY_PIXEL_FORMAT_STRING, &pfs) && pfs) {
+        if (av_stristr(pfs, "10bit") || av_stristr(pfs, "P010"))
+            return AV_PIX_FMT_P010;
+        if (av_stristr(pfs, "NV21"))
+            return AV_PIX_FMT_NV21;
+        if (av_stristr(pfs, "NV12"))
+            return AV_PIX_FMT_NV12;
+    }
+    return AV_PIX_FMT_NONE;
+}
+
+static void oh_decode_fill_native_format_hint(enum AVPixelFormat sw,
+                                              OH_NativeBuffer_Format *native_format_out)
+{
+    if (!native_format_out)
+        return;
+    switch (sw) {
+    case AV_PIX_FMT_P010:
+        *native_format_out = NATIVEBUFFER_PIXEL_FMT_YCBCR_P010;
+        break;
+    case AV_PIX_FMT_NV12:
+        *native_format_out = NATIVEBUFFER_PIXEL_FMT_YCBCR_420_SP;
+        break;
+    case AV_PIX_FMT_NV21:
+        *native_format_out = NATIVEBUFFER_PIXEL_FMT_YCRCB_420_SP;
+        break;
+    default:
+        break;
+    }
+}
+
+static enum AVPixelFormat oh_decode_resolve_sw_format(AVCodecContext *avctx,
+                                                      OH_AVBuffer *buffer,
+                                                      OH_NativeBuffer_Format *native_format_out)
+{
+    OHCodecDecContext *s = avctx->priv_data;
+
+    /*
+     * SURFACE / ConsumerSurface: OH_AVBuffer has no CPU-mappable memory.
+     * Calling GetNativeBuffer() spams "buffer's memory is nullptr" and never
+     * yields a real format — keep the sw_pix_fmt resolved at OnStreamChanged.
+     */
+    if (s->output_to_window || s->output_hw_frame) {
+        oh_decode_fill_native_format_hint(avctx->sw_pix_fmt, native_format_out);
+        return avctx->sw_pix_fmt;
+    }
+
+    OH_NativeBuffer *native_buffer = OH_AVBuffer_GetNativeBuffer(buffer);
+    if (!native_buffer)
+        return avctx->sw_pix_fmt;
+
+    OH_NativeBuffer_Config config = {0};
+    OH_NativeBuffer_GetConfig(native_buffer, &config);
+    OH_NativeBuffer_Unreference(native_buffer);
+
+    if (native_format_out)
+        *native_format_out = config.format;
+
+    enum AVPixelFormat sw_format = oh_sw_format_from_native_format(config.format);
+    return sw_format == AV_PIX_FMT_NONE ? avctx->sw_pix_fmt : sw_format;
+}
+
+static AVOHCodecDeviceContext *oh_decode_device_hwctx(AVCodecContext *avctx)
+{
+    if (!avctx->hw_device_ctx)
+        return NULL;
+
+    AVHWDeviceContext *device_ctx = (AVHWDeviceContext *)avctx->hw_device_ctx->data;
+    if (!device_ctx || device_ctx->type != AV_HWDEVICE_TYPE_OHCODEC)
+        return NULL;
+
+    return device_ctx->hwctx;
+}
+
+static uint64_t oh_decode_output_generation(AVCodecContext *avctx)
+{
+    AVOHCodecDeviceContext *dev = oh_decode_device_hwctx(avctx);
+    return dev ? dev->output_generation : 0;
+}
+
+static void oh_decode_invalidate_outputs(AVCodecContext *avctx)
+{
+    AVOHCodecDeviceContext *dev = oh_decode_device_hwctx(avctx);
+    if (dev)
+        dev->output_generation++;
+}
 
