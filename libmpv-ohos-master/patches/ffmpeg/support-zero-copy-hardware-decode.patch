+static int oh_decode_append_nal(uint8_t **out, int *out_size,
+                                const uint8_t *nal, int nal_size)
+{
+    uint8_t *p = av_realloc(*out, *out_size + 4 + nal_size +
+                            AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!p)
+        return AVERROR(ENOMEM);
+    *out = p;
+    AV_WB32(p + *out_size, 1);
+    memcpy(p + *out_size + 4, nal, nal_size);
+    *out_size += 4 + nal_size;
+    return 0;
+}
+
+static int oh_decode_capture_ps_from_annexb(OHCodecDecContext *s,
+                                            AVCodecContext *avctx,
+                                            const uint8_t *data, int size)
+{
+    const uint8_t *p = data;
+    const uint8_t *end = data + size;
+    uint8_t *out = NULL;
+    int out_size = 0;
+    int got_sps = 0;
+    int ret;
+
+    if (!data || size < 5)
+        return 0;
+
+    while (p + 4 < end) {
+        const uint8_t *nal_start;
+        const uint8_t *next;
+        int nal_type, nal_size;
+
+        if (p[0] == 0 && p[1] == 0 && p[2] == 1) {
+            nal_start = p + 3;
+        } else if (p[0] == 0 && p[1] == 0 && p[2] == 0 && p[3] == 1) {
+            nal_start = p + 4;
+        } else {
+            p++;
+            continue;
+        }
+        next = nal_start;
+        while (next + 3 < end) {
+            if (next[0] == 0 && next[1] == 0 &&
+                (next[2] == 1 || (next[2] == 0 && next[3] == 1)))
+                break;
+            next++;
+        }
+        if (next + 3 >= end)
+            next = end;
+        nal_size = (int)(next - nal_start);
+        if (nal_size <= 0) {
+            p = next;
+            continue;
+        }
+        if (avctx->codec_id == AV_CODEC_ID_HEVC)
+            nal_type = (nal_start[0] >> 1) & 0x3f;
+        else
+            nal_type = nal_start[0] & 0x1f;
+
+        if (avctx->codec_id == AV_CODEC_ID_HEVC) {
+            if (nal_type == 32 || nal_type == 33 || nal_type == 34) {
+                ret = oh_decode_append_nal(&out, &out_size, nal_start, nal_size);
+                if (ret < 0) {
+                    av_free(out);
+                    return ret;
+                }
+                if (nal_type == 33)
+                    got_sps = 1;
+            }
+        } else if (nal_type == 7 || nal_type == 8) {
+            ret = oh_decode_append_nal(&out, &out_size, nal_start, nal_size);
+            if (ret < 0) {
+                av_free(out);
+                return ret;
+            }
+            if (nal_type == 7)
+                got_sps = 1;
+        }
+        p = next;
+    }
+
+    /* Only a capture that actually carries SPS may be treated as "parameter
+     * sets ready". A PPS-only capture would make ps_size non-zero and cause
+     * the bootstrap path to skip prepending SPS, so OHCodec would still fail
+     * with "missing parameter sets".
+     */
+    if (out_size <= 0 || !got_sps) {
+        av_free(out);
+        return 0;
+    }
+    memset(out + out_size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    av_freep(&s->ps_data);
+    s->ps_data = out;
+    s->ps_size = out_size;
+    av_log(avctx, AV_LOG_INFO,
+           "Captured AnnexB codec config (%d bytes) from bitstream\n",
+           out_size);
+    return 0;
+}
