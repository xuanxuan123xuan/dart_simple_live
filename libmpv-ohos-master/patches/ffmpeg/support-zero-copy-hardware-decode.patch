+static int oh_decode_prepare_ps(OHCodecDecContext *s, AVCodecContext *avctx)
+{
+    if (s->ps_data && s->ps_size > 0)
+        return 0;
+    return oh_decode_prepare_ps_from_bytes(s, avctx, avctx->extradata,
+                                           avctx->extradata_size);
