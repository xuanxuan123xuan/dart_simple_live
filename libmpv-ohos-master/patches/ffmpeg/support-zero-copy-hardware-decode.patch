+static int oh_decode_prepare_ps_from_bytes(OHCodecDecContext *s,
+                                           AVCodecContext *avctx,
+                                           const uint8_t *in, int in_size)
+{
+    uint8_t *out = NULL;
+    int out_size = 0;
+
+    if (!in || in_size <= 0)
+        return 0;
+
+    if ((in_size >= 4 && AV_RB32(in) == 1) ||
+        (in_size >= 3 && AV_RB24(in) == 1)) {
+        return oh_decode_capture_ps_from_annexb(s, avctx, in, in_size);
+    }
+
+    if (avctx->codec_id == AV_CODEC_ID_H264 && in_size >= 7 && in[0] == 1) {
+        const uint8_t *p = in + 5;
+        const uint8_t *end = in + in_size;
+        int sps_count, pps_count, i;
+        if (p >= end)
+            return AVERROR_INVALIDDATA;
+        sps_count = *p++ & 0x1f;
+        /* 无 SPS 的 avcC 不能当作参数集就绪：只有 PPS 时 OHCodec 仍会
+         * missing parameter sets，需继续等带内 SPS。 */
+        if (sps_count <= 0)
+            return 0;
+        for (i = 0; i < sps_count; i++) {
+            int n;
+            if (p + 2 > end)
+                return AVERROR_INVALIDDATA;
+            n = AV_RB16(p);
+            p += 2;
+            if (p + n > end)
+                return AVERROR_INVALIDDATA;
+            if (oh_decode_append_nal(&out, &out_size, p, n) < 0) {
+                av_free(out);
+                return AVERROR(ENOMEM);
+            }
+            p += n;
+        }
+        if (p >= end) {
+            av_free(out);
+            return AVERROR_INVALIDDATA;
+        }
+        pps_count = *p++;
+        for (i = 0; i < pps_count; i++) {
+            int n;
+            if (p + 2 > end)
+                return AVERROR_INVALIDDATA;
+            n = AV_RB16(p);
+            p += 2;
+            if (p + n > end)
+                return AVERROR_INVALIDDATA;
+            if (oh_decode_append_nal(&out, &out_size, p, n) < 0) {
+                av_free(out);
+                return AVERROR(ENOMEM);
+            }
+            p += n;
+        }
+        if (out_size > 0) {
+            memset(out + out_size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+            av_freep(&s->ps_data);
+            s->ps_data = out;
+            s->ps_size = out_size;
+            av_log(avctx, AV_LOG_INFO,
+                   "Prepared AnnexB codec config (%d bytes) for OHCodec\n",
+                   out_size);
+            return 0;
+        }
+        av_free(out);
+        return 0;
+    }
+
+    av_log(avctx, AV_LOG_WARNING,
+           "OHCodec: unsupported extradata format (codec=%d size=%d)\n",
+           avctx->codec_id, in_size);
+    return 0;
+}
