+    cap = OH_AVBuffer_GetCapacity(input->buffer);
+    if (!p || cap <= 0)
+        return AVERROR_EXTERNAL;
+    n = FFMIN(size, cap);
+    memcpy(p, data, n);
+    if (n < size)
+        flags |= AVCODEC_BUFFER_FLAGS_INCOMPLETE_FRAME;
